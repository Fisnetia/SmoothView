{
    "$schema": "https://raw.githubusercontent.com/BetterNCM/BetterNCM-Plugins/refs/heads/master/manifest-schema.json",
    "manifest_version": 1,
    "name": "SmoothView",
    "slug": "smooth-view",
    "version": "1.0.0",
    "author": "Fina",
    "author_link": "https://github.com/Fisnetia",
    "description": "界面动效：图片按位置依次渐显，歌单逐行渐显，鼠标滚轮丝滑滚动，切换页面淡入过渡，标题栏毛玻璃。",
    "type": "extension",
    "betterncm_version": ">=1.3.4",
    "ncm3-compatible": true,
    "ncm-version-req": ">= 3.1.20",
    "require_restart": false,
    "injects": {
        "Main": [
            {
                "file": "main.js"
            }
        ]
    }
}
